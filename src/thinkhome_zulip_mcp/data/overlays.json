  "paths": {
    "/users/me/onboarding_steps": {
      "post": {
        "operationId": "mark-onboarding-step-read",
        "summary": "Mark a personal onboarding step as read",
        "description": "Undocumented human-user endpoint. Omit reminder delay unless scheduling for navigation_tour_video. JSON null is not accepted for the delay; scheduling policy is checked by Zulip.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "onboarding_step": {
                    "type": "string",
                    "enum": [
                      "visibility_policy_banner",
                      "intro_inbox_view_modal",
                      "intro_recent_view_modal",
                      "first_stream_created_banner",
                      "jump_to_conversation_banner",
                      "non_interleaved_view_messages_fading",
                      "interleaved_view_messages_fading",
                      "intro_resolve_topic",
                      "navigation_tour_video",
                      "intro_go_to_conversation_tooltip",
                      "narrow_to_dm_with_welcome_bot_new_user"
                    ]
                  },
                  "schedule_navigation_tour_video_reminder_delay": {
                    "type": "integer",
                    "description": "Seconds until a welcome-video reminder; only for navigation_tour_video."
                  }
                },
                "required": [
                  "onboarding_step"
                ],
                "anyOf": [
                  {
                    "not": {
                      "required": [
                        "schedule_navigation_tour_video_reminder_delay"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "onboarding_step": {
                        "enum": [
                          "navigation_tour_video"
                        ]
                      }
                    }
                  }
                ]
              },
              "encoding": {
                "schedule_navigation_tour_video_reminder_delay": {
                  "contentType": "application/json"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The step was recorded and any requested reminder scheduled."
          }
        },
        "x-thinkhome": {
          "stability": "undocumented",
          "authentication": "zulip_api_key",
